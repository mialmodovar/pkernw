# Copy to .env and fill in before `docker compose up`.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# The hostname(s) the app is served on. No wildcards in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the Django admin login form over https.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Leave blank to allow any origin. Set it once the domain is known.
DJANGO_CORS_ORIGINS=

POSTGRES_DB=poker
POSTGRES_USER=poker
POSTGRES_PASSWORD=change-me

# Port nginx is published on.
HTTP_PORT=8080
