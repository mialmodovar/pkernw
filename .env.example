# Copy to .env and fill in before `docker compose up`.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# The hostname(s) the app is served on. No wildcards in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the Django admin login form.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

POSTGRES_DB=poker
POSTGRES_USER=poker
POSTGRES_PASSWORD=change-me

# Port the app is published on locally.
HTTP_PORT=8080

# Table GIFs (chat reactions and knockout finishers). Giphy web keys are public
# by design — they identify the app, not the player — so these are baked into
# the frontend bundle at build time. Get them at https://developers.giphy.com.
# Without any, everything else works and the GIF picker says it needs a key.
#
# A comma-separated list, because one key's hourly allowance is small and the
# whole table shares it. Requests go round them in turn and a key that comes
# back rate-limited is rested for the hour — see frontend/src/api/giphyKeys.js.
# One key per Giphy app, so more keys means creating more apps in that console.
VITE_GIPHY_API_KEYS=

# The single-key variable this used to be. Still honoured, and counted as one
# more key in the rotation, so an existing deploy needs no change.
VITE_GIPHY_API_KEY=
