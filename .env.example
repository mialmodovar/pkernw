# Copy to .env and fill in before `docker compose up`.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# The hostname(s) the app is served on. No wildcards in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the Django admin login form.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

POSTGRES_DB=poker
POSTGRES_USER=poker
POSTGRES_PASSWORD=change-me

# Port the app is published on locally.
HTTP_PORT=8080

# Table GIFs (chat reactions and knockout finishers). Giphy web keys are public
# by design — they identify the app, not the player — so this is baked into the
# frontend bundle at build time. Get one at https://developers.giphy.com.
# Without it everything else works and the GIF picker says it needs a key.
VITE_GIPHY_API_KEY=
